direction: right

start: {
  shape: circle
  label: ""
  style.fill: black
}
pending: "pending"
confirmed: "confirmed"
cancelled: "cancelled"
completed: "completed"
end_cancelled: {
  shape: circle
  label: ""
}
end_completed: {
  shape: circle
  label: ""
}

start -> pending: POST /bookings
pending -> confirmed: staff/admin confirm
pending -> cancelled: owner/staff/admin cancel
confirmed -> cancelled: owner/staff/admin cancel
confirmed -> completed: staff/admin complete
confirmed -> confirmed: confirm (idempotent)
completed -> completed: complete (idempotent)
cancelled -> cancelled: cancel (idempotent)
cancelled -> end_cancelled
completed -> end_completed
